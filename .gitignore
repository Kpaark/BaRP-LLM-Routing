# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Generated artifacts (rebuilt by scripts in barp/)
# Big tensors / tables live under cache/ (HF download + embeddings),
# data/ (in-distribution) or data_ood/ (OOD), and are produced by
# setup_data.py / build_bandit_table.py. Checkpoints live under runs/.
# GitHub rejects single files >100 MB, and X.npy is ~107 MB, so all of these
# must stay out of version control and be regenerated locally.
cache/
data*/*.npy
data*/*.npz
data*/*.pkl
data*/*.parquet
data*/*.csv
data*/*.json

# Environment / secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Matplotlib local cache (used so font cache writes stay inside the workspace)
.mpl-cache/
